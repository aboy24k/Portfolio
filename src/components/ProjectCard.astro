---
/**
 * ProjectCard: one "scrapbook case study".
 *
 * Renders (1) the card, with a tilted polaroid on a grid mounting board, and
 * (2) a native <dialog> modal that holds the full write-up.
 *
 * Usage (see src/pages/index.astro):
 *   <ProjectCard project={entry} index={i}>
 *     <Content />        <- the rendered Markdown body goes in the modal
 *   </ProjectCard>
 *
 * WHERE TO PLUG IN CONTENT
 *   - Photo:     `cover: images/your-photo.jpg` in the project's frontmatter
 *                (file lives in public/images/). Full https:// URLs also work.
 *   - Caption:   `caption: ...` in frontmatter (handwritten text under the photo).
 *   - Deep dive: everything below the frontmatter in the .md file.
 *   - Links:     `links:` list in frontmatter becomes buttons in the modal.
 */
import type { CollectionEntry } from 'astro:content';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { withBase } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { id, data } = project;

// A slightly different tilt for each polaroid, like photos stuck down by hand.
const tilts = [-1.6, 1.2, 1, -0.9];
const tilt = tilts[index % tilts.length];

// Each card gets its own mounting paper (kraft, graph, blueprint, notebook)
// and its own pair of washi tapes, so the page never looks stamped from one mold.
const variant = index % 4;
const tapePairs = [
  ['tape-stripe', 'tape-kraft'],
  ['tape-dots', 'tape-stripe'],
  ['tape-red', 'tape-dots'],
  ['tape-kraft', 'tape-grid'],
];
const [tapeA, tapeB] = tapePairs[variant];

const coverUrl = data.cover ? withBase(data.cover) : null;

// Words used by the skills matrix to decide whether this project matches a skill.
const keys = [...data.tags, ...data.alsoUses].map((t) => t.toLowerCase());
---

<div class="project">
  <article
    class="card on-paper"
    id={`project-${id}`}
    data-project={id}
    data-title={data.title}
    data-keys={keys.join('|')}
    style={`--tilt:${tilt}deg`}
  >
    {
      data.badge && (
        <div class="stamp" role="img" aria-label={`Award: ${data.badge}`}>
          <span>
            <strong>{data.badge.split(' ')[0]}</strong>
            {data.badge.split(' ').slice(1).join(' ')}
          </span>
        </div>
      )
    }

    <div class="card-paper">
      <div class="board" data-variant={variant}>
        <span class="peek" aria-hidden="true"></span>
        <figure class="polaroid">
          <span class={`tape tape-tl ${tapeA}`} aria-hidden="true"></span>
          <span class={`tape tape-tr ${tapeB}`} aria-hidden="true"></span>
          <div class="photo">
            {
              coverUrl ? (
                <img src={coverUrl} alt={data.coverAlt} loading="lazy" decoding="async" />
              ) : (
                <PhotoPlaceholder uid={`${id}-card`} label="photo goes here" />
              )
            }
          </div>
          <figcaption>{data.caption ?? ''}</figcaption>
        </figure>
      </div>

      <div class="title-wrap">
        <div class="title-scrap">
          <h3 class="m-0 text-[1.45rem] font-extrabold leading-tight tracking-tight">{data.title}</h3>
        </div>
      </div>

      <div class="flex flex-col gap-4 px-3 pt-4 sm:px-4">
        {data.context && <p class="strip m-0 w-fit max-w-full">{data.context}</p>}

        <p class="m-0 max-w-[58ch]">{data.summary}</p>

        <ul class="m-0 flex list-none flex-wrap gap-2 p-0" aria-label="Tools and methods">
          {data.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>

        <div class="drop -rotate-1 self-start pt-1">
          <button type="button" class="ticket" data-open-project={id} aria-haspopup="dialog">
            <span class="ticket-main">Read the case study</span>
            <span class="ticket-stub"><span class="barcode"></span>open</span>
          </button>
        </div>
      </div>
    </div>
  </article>

  <!-- CASE STUDY MODAL -->
  <dialog id={`case-${id}`} class="case" aria-labelledby={`case-title-${id}`}>
    <div>
      <header
        class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-rule bg-card p-5 sm:p-6"
      >
        <div>
          <h3 id={`case-title-${id}`} class="text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl">
            {data.title}
          </h3>
          {
            (data.context || data.period) && (
              <p class="mt-1 text-muted">{[data.context, data.period].filter(Boolean).join(', ')}</p>
            )
          }
        </div>
        <button type="button" class="btn shrink-0" data-close-dialog>Close</button>
      </header>

      <div class="p-5 sm:p-6">
        {
          coverUrl ? (
            <figure class="m-0 flex justify-center">
              <img
                src={coverUrl}
                alt={data.coverAlt}
                loading="lazy"
                decoding="async"
                class="block h-auto max-h-[26rem] w-auto max-w-full bg-[#fffefb] p-2 shadow-[0_1px_1px_rgb(0_0_0/0.12),0_12px_16px_-10px_rgb(0_0_0/0.45)]"
              />
            </figure>
          ) : (
            <figure
              class="m-0 overflow-hidden rounded-sm border border-rule [&>svg]:block [&>svg]:h-full [&>svg]:w-full"
              style="aspect-ratio: 16 / 9;"
            >
              <PhotoPlaceholder uid={`${id}-modal`} label="photo goes here" />
            </figure>
          )
        }

        <ul class="m-0 mt-5 flex list-none flex-wrap gap-2 p-0" aria-label="Tools and methods">
          {data.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>

        {
          data.video && (
            <figure class="case-video m-0 mt-6 flex flex-col items-center">
              <video
                controls
                playsinline
                preload="metadata"
                poster={data.poster ? withBase(data.poster) : undefined}
                src={withBase(data.video)}
                aria-label={data.videoCaption ?? `${data.title}, video`}
              >
                Your browser cannot play this video.
              </video>
              {data.videoCaption && <figcaption>{data.videoCaption}</figcaption>}
            </figure>
          )
        }

        <div class="case-body mt-6">
          <slot />
        </div>

        {
          data.links.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3 border-t border-rule pt-5">
              {data.links.map((link) => (
                <a
                  class="btn btn-primary"
                  href={withBase(link.url)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </dialog>
</div>

<script>
  // Shared by every card on the page (Astro bundles this script once).
  function openCase(id: string) {
    const dialog = document.getElementById(`case-${id}`) as HTMLDialogElement | null;
    if (!dialog || dialog.open) return;
    dialog.showModal();
    history.replaceState(null, '', `#case-${id}`); // shareable link to this case study
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const opener = target.closest<HTMLElement>('[data-open-project]');
    if (opener?.dataset.openProject) {
      openCase(opener.dataset.openProject);
      return;
    }

    if (target.closest('[data-close-dialog]')) {
      target.closest('dialog')?.close();
      return;
    }

    // Click on the dimmed backdrop closes the modal. The rect check keeps
    // scrollbar clicks (which also target the <dialog>) from closing it.
    if (target instanceof HTMLDialogElement && target.classList.contains('case')) {
      const r = target.getBoundingClientRect();
      const outside =
        event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom;
      if (outside) target.close();
    }
  });

  // 'close' does not bubble, so listen in the capture phase.
  document.addEventListener(
    'close',
    (event) => {
      if ((event.target as HTMLElement).classList?.contains('case')) {
        history.replaceState(null, '', location.pathname + location.search);
      }
    },
    true,
  );

  // Deep link: /#case-<project-id> opens that case study on load.
  const match = location.hash.match(/^#case-(.+)$/);
  if (match) openCase(match[1]);
</script>
